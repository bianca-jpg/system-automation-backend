# Molde de configuração. Copie para .env e preencha com os valores reais.
#   cp .env.example .env
# O .env é gitignored — segredos (senhas, JWT, token Databricks) ficam só nele.

# Ambiente: dev | prod
ENV=dev

# Banco de Dados (Postgres)
# settings.py aceita POSTGRES_* ou o prefixo do ambiente (ex.: DEV_POSTGRES_*).
# No host, use localhost. O compose injeta DEV_POSTGRES_HOST=dev_db nos
# containers; aliases legados de container também são traduzidos no host.
POSTGRES_USER=atacado
POSTGRES_PASSWORD=atacado
POSTGRES_DB=atacado_or
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Sobrescrita opcional da URL completa do banco (tem prioridade sobre POSTGRES_*)
# DATABASE_URL=postgresql://usuario:senha@host:5432/atacado_or
# O compose standalone `.docker/docker-compose.prod.yml` exige URLs remotas explícitas:
# PROD_DATABASE_URL=postgresql://usuario:senha@rds:5432/atacado_or
# Host do Postgres ao rodar comandos no host (uv run / pytest):
# DEV_POSTGRES_HOST_LOCAL=localhost
# TLS: o default é `prefer` em dev e `require` quando ENV=prod. Para validação
# de certificado use `verify-ca`/`verify-full` com a CA disponível no runtime.
# POSTGRES_SSL_MODE=prefer
POSTGRES_CONNECT_TIMEOUT_SECONDS=5
POSTGRES_COMMAND_TIMEOUT_SECONDS=60
# Migrations de dados têm orçamento separado e continuam bounded.
POSTGRES_MIGRATION_TIMEOUT_SECONDS=900

# Porta da aplicação e UID/GID para o build Docker
APP_PORT=8000
UID=1000
GID=1000

# Databricks (origem dos dados de pedidos/estoque)
# Conexao: SQL Warehouses -> Connection details
# Token: Settings -> Developer -> Access tokens (NÃO versionar; só no .env)
DATABRICKS_SERVER_HOSTNAME=adb-xxxxxxxxxxxx.xx.azuredatabricks.net
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx
DATABRICKS_TOKEN=
# Enderecos completos das tabelas: catalogo.schema.tabela
# PEDIDOS = view autoritativa de pedidos EM ABERTO (alimenta a aba "Pedidos em Aberto").
DATABRICKS_TABELA_PEDIDOS=catalogo.schema.pedidos_em_aberto
DATABRICKS_TABELA_ESTOQUE=catalogo.schema.estoque
# Tabela do ERP com os flags de processamento (indica_reserva/indica_embalado).
# Fonte de verdade sobre o que ja foi realmente processado (reserva/embalado).
DATABRICKS_TABELA_PEDIDOS_PROCESSADOS=catalogo.schema.pedidos_processados
# Referência tamanho->posição da view programa_estagio.refined.atacado_or_prod_tamanho_ref.
DATABRICKS_TABELA_TAMANHO_REF=catalogo.schema.tamanho_ref
# O timeout de cada chamada cabe em um deadline total por consulta. Retries
# ocorrem apenas para 429/5xx/transporte e respeitam Retry-After com teto.
DATABRICKS_REQUEST_TIMEOUT_SECONDS=30
DATABRICKS_TOTAL_TIMEOUT_SECONDS=900
DATABRICKS_CANCEL_TIMEOUT_SECONDS=3
DATABRICKS_MAX_ATTEMPTS=4
DATABRICKS_RETRY_BASE_SECONDS=0.5
DATABRICKS_RETRY_MAX_SECONDS=8
DATABRICKS_POLL_INTERVAL_SECONDS=2
DATABRICKS_MAX_POLLS=450
# Tetos da coleta. Os defaults acomodam as fontes atuais (incluindo ERP com
# ~676 mil linhas) sem permitir crescimento ilimitado em memória/rede.
DATABRICKS_MAX_CHUNKS=2048
DATABRICKS_MAX_ROWS=1500000
DATABRICKS_MAX_BYTES=536870912
# A API aceita até 16 MiB de SQL; a aplicação usa um teto bem menor por padrão.
DATABRICKS_MAX_STATEMENT_BYTES=1048576
# Somente URLs HTTPS desses sufixos podem ser baixadas por EXTERNAL_LINKS.
DATABRICKS_EXTERNAL_HOST_SUFFIXES=.blob.core.windows.net,.dfs.core.windows.net
# Intervalo (s) do sync periodico Databricks->Postgres (Celery beat). 7200s = 2 horas.
INGESTAO_INTERVALO_SEGUNDOS=7200
# Orçamento fim-a-fim das cinco fontes + swap; 300..3600 segundos.
INGESTAO_TOTAL_TIMEOUT_SECONDS=1800
# Ano dos pedidos processados trazidos para o Historico (year(dt_emissao)). Default 2026.
INGESTAO_ANO_HISTORICO=2026

# Redis e Celery
# No host, use localhost. O compose injeta o serviço `redis` nos containers.
# REDIS_URL_LOCAL troca host/porta sem misturar /0 (API/broker) e /1 (result).
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Worker exclusivo de `orders_processing`: concurrency/prefetch são fixos em 1.
# O recycle ocorre após a task; ele não interrompe uma execução acima do limiar.
ORDERS_PROCESSING_MAX_TASKS_PER_CHILD=20
ORDERS_PROCESSING_MAX_MEMORY_PER_CHILD_KB=1048576
# Peak medido ~434 MiB; a projeção no teto de 200k itens fica em ~600 MiB.
ORDERS_PROCESSING_MEMORY_RESERVATION=1280m
ORDERS_PROCESSING_MEMORY_LIMIT=1536m
# Produção (usadas somente pelo compose prod standalone; nunca aponte para local):
# PROD_REDIS_URL=rediss://cache-remoto:6379/0
# PROD_CELERY_BROKER_URL=rediss://cache-remoto:6379/0
# PROD_CELERY_RESULT_BACKEND=rediss://cache-remoto:6379/1

# Realtime (outbox transacional -> Redis Stream -> WebSocket)
# O Stream guarda uma janela limitada para replay; eventos continuam
# persistidos no Postgres pelo período de retenção configurado abaixo.
REALTIME_STREAM_KEY=atacado:realtime:v1
REALTIME_REDIS_CONNECT_TIMEOUT_SECONDS=2.0
REALTIME_REDIS_SOCKET_TIMEOUT_SECONDS=5.0
REALTIME_STREAM_MAXLEN=20000
REALTIME_PAYLOAD_MAX_BYTES=16384
# Tickets WebSocket são de uso único, têm TTL curto e limite por usuário/IP.
REALTIME_TICKET_TTL_SECONDS=30
REALTIME_TICKET_USER_RATE_PER_MINUTE=12
REALTIME_TICKET_IP_RATE_PER_MINUTE=60
# Filas/conexões têm limites para proteger a memória de cada instância da API.
REALTIME_CONNECTION_QUEUE_SIZE=128
REALTIME_MAX_CONNECTIONS_PER_USER=4
REALTIME_MAX_CONNECTIONS_PER_INSTANCE=1000
REALTIME_HEARTBEAT_SECONDS=20
REALTIME_IDLE_TIMEOUT_SECONDS=65
REALTIME_AUTH_REVALIDATE_SECONDS=60
# Relay do outbox, limpeza e tópicos públicos aceitos.
REALTIME_RELAY_INTERVAL_MS=250
REALTIME_RELAY_BATCH_SIZE=100
REALTIME_REPLAY_MAX_EVENTS=250
REALTIME_SEND_TIMEOUT_SECONDS=5
REALTIME_REPLAY_TIMEOUT_SECONDS=15
REALTIME_OUTBOX_RETENTION_DAYS=14
REALTIME_CLEANUP_INTERVAL_SECONDS=3600
REALTIME_ALLOWED_TOPICS=orders,alerts,communications,history

# Segurança (gere um JWT_SECRET forte em produção)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Login via Microsoft Entra ID (SSO). Application (client) ID e Directory
# (tenant) ID vêm da tela "Overview" do app registrado no Entra ID. Vazios =
# POST /api/auth/sso/microsoft responde 503 em vez de tentar validar contra
# um tenant inexistente.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=

# Chave que o scraper Prometheus manda no header X-Metrics-Key para acessar
# GET /metrics. Gerar com `openssl rand -hex 32`. Vazia = GET /metrics
# responde 503 (nunca abre sem chave configurada). PROD exige >= 32
# caracteres, senão o boot falha.
METRICS_API_KEY=

# Teto do corpo da requisição; acima disso a API responde 413 sem executar a rota
REQUEST_MAX_BODY_BYTES=2097152

# CIDRs de peer confiados para os cabeçalhos X-Forwarded-* do uvicorn
# (--forwarded-allow-ips). Normalmente só o time de infra mexe aqui — o
# default no .docker/Dockerfile já aponta para as subnets privadas atuais da
# VPC do ECS. Ajustar só se a VPC mudar.
UVICORN_FORWARDED_ALLOW_IPS=30.1.1.0/24,30.1.11.0/24,30.1.21.0/24

# Frontend (CORS — separado por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Envio de e-mail (SMTP) — cadastro/OTP e "Comunicar Time Comercial".
# Provider-agnóstico: Gmail (teste), Microsoft 365 ou Amazon SES.
#
# Amazon SES (recomendado neste projeto, mesma conta AWS do ECS):
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_STARTTLS=true
#   SMTP_USER / SMTP_PASSWORD = credenciais SMTP do SES (não a chave IAM crua)
#   SMTP_FROM = endereço de um domínio/e-mail verificado no SES
# Sandbox do SES só entrega para identidades verificadas até sair do sandbox.
#
# TESTE com Gmail (self-service, sem depender do TI):
#   1) Conta Google -> Segurança -> ativar verificação em 2 etapas
#   2) Segurança -> Senhas de app -> gerar (16 dígitos) e usar em SMTP_PASSWORD
# PRODUÇÃO com Microsoft 365 (precisa o TI habilitar "Authenticated SMTP"):
#   SMTP_HOST=smtp.office365.com
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Deadline wall-clock da conversa SMTP completa, não de cada comando isolado.
SMTP_TIMEOUT_SECONDS=10
# Delivery outbox: POST apenas agenda; o worker envia e o beat reconcilia.
COMMUNICATION_DELIVERY_INTERVAL_SECONDS=30
COMMUNICATION_DELIVERY_BATCH_SIZE=20
COMMUNICATION_DELIVERY_MAX_ATTEMPTS=5
# O lease deve superar o deadline SMTP total em >=30s. Retry exponencial é limitado.
COMMUNICATION_DELIVERY_LEASE_SECONDS=120
COMMUNICATION_DELIVERY_RETRY_BASE_SECONDS=30
COMMUNICATION_DELIVERY_RETRY_MAX_SECONDS=1800

# Inicialização (schema exclusivamente via Alembic)
# Adequação
TOLERANCIA_ADEQUACAO=0.05
CRITERIO_SELECAO=valor
